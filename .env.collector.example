# 境外采集节点配置：复制为仓库根目录下的 .env.collector（已被 git 忽略）。不要把真实令牌写入仓库。
OPTI_GATEWAY_URL=https://host.docker.internal:8443
OPTI_NODE_ID=hk1
OPTI_SECRET_COLLECTOR_NODE_TOKEN=
OPTI_COLLECTOR_STREAMS=certstream,own_domain_ct
# 富化任务执行槽（境内在同步等待结果）与采集运行执行槽（运行可能持续数分钟），两者互不占用
OPTI_COLLECTOR_CONCURRENCY=4
OPTI_COLLECTOR_RUN_CONCURRENCY=2
# 截图 OCR（英语/简体中文）默认关闭；启动 browser 时用 docker compose --env-file .env.collector 注入
OPTI_SANDBOX_OCR_ENABLED=false

# 钓鱼情报源（S2-A）：remote 模式下放在境外节点，未批准或未配置时不会运行
OPTI_SECRET_URLHAUS_AUTH_KEY=
OPTI_SECRET_PHISHTANK_APP_KEY=
OPTI_SECRET_URLSCAN_API_KEY=

# 代码与密钥泄露（S3-C）：仅公开仓库只读权限
OPTI_SECRET_GITHUB_CODE_TOKEN=
# 可选：扫描前查询仓库信息的只读令牌
OPTI_SECRET_SECRET_SCAN_GITHUB_TOKEN=
# 新闻与搜索（S4-B）：Brave 新闻搜索令牌；启用前需确认条款并批准连接器
OPTI_SECRET_BRAVE_NEWS_API_KEY=

# 威胁情报（S4-C）：ThreatFox 使用 abuse.ch Auth-Key；OTX 需账户 API Key。
# 两者均需先确认机构使用条款，再批准对应连接器。
OPTI_SECRET_THREATFOX_AUTH_KEY=
OPTI_SECRET_OTX_API_KEY=

# 发现密钥的遮蔽指纹密钥：必须与平台 .env 中的 OPTI_SECRET_MASK_KEY 完全相同，缺失时节点拒绝启动
OPTI_SECRET_MASK_KEY=
