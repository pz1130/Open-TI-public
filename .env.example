# 复制为 .env 后填写（.env 已被 git 忽略）。不要把真实密钥写入仓库（设计文档 2.7）。
OPTI_SECRET_ALERTING_TEAMS_WEBHOOK_URL=
OPTI_SECRET_ALERTING_SMTP_USERNAME=
OPTI_SECRET_ALERTING_SMTP_PASSWORD=


# local：单机开发；remote：采集与截图交给境外节点（同时启动 deploy/compose.collector.yml，并用 --profile remote 启动网关）
OPTI_COLLECTOR_MODE=local
# 本地 browser 容器的截图 OCR，默认关闭
OPTI_SANDBOX_OCR_ENABLED=false
# 每个采集节点一个令牌（至少 32 个字符，例如 openssl rand -hex 32），与该节点 .env.collector 中的值相同
OPTI_SECRET_GATEWAY_NODE_HK1=


# 研判界面：本机用 http 访问时必须设为 false（否则浏览器不会回传 Secure Cookie）；生产经 HTTPS 访问保持 true
OPTI_COOKIE_SECURE=false
# 仅本机体验时绑定回环地址；运行 Compose 时加 --env-file .env 才会应用此端口插值
# OPTI_API_BIND=127.0.0.1

# 钓鱼情报源（S2-A）：remote 模式下放在境外节点，未批准或未配置时不会运行
OPTI_SECRET_URLHAUS_AUTH_KEY=
OPTI_SECRET_PHISHTANK_APP_KEY=
OPTI_SECRET_URLSCAN_API_KEY=

# 机构信息与关键词：生产部署替换为本机构授权规则，默认只是中性示例。
OPTI_ORGANIZATION=config/organization.yaml
OPTI_RULES=config/projects/example/keywords.yaml
# 机构自有数据（S2-B），填写后在连接器配置中启用；Graph 仅 Mail.Read 并限定邮箱。
OPTI_REPORT_MAILBOX=
OPTI_SECRET_REPORT_MAILBOX_TENANT_ID=
OPTI_SECRET_REPORT_MAILBOX_CLIENT_ID=
OPTI_SECRET_REPORT_MAILBOX_CLIENT_SECRET=
OPTI_DMARC_MAILBOX=
OPTI_SECRET_DMARC_TENANT_ID=
OPTI_SECRET_DMARC_CLIENT_ID=
OPTI_SECRET_DMARC_CLIENT_SECRET=
OPTI_SECRET_INTAKE_CANARY_TOKEN=
OPTI_SECRET_INTAKE_REPORT_KEY=
OPTI_INTAKE_FORWARD=direct
OPTI_INTAKE_PREFIX=/ti-intake
OPTI_SYSLOG_MIN_HITS=3


# 处置闭环（S2-C）：下架渠道、模板与工单配置文件（默认在镜像内的 config/ 下，可挂载覆盖）
OPTI_TAKEDOWN_CONFIG=config/takedown/platforms.yaml
OPTI_TAKEDOWN_TEMPLATES=config/takedown/templates
OPTI_TICKETS_CONFIG=config/tickets.yaml
# 工单 Webhook 地址与签名密钥（≥32 个字符；工单系统回调用同一密钥签名）
OPTI_SECRET_TICKETS_WEBHOOK_URL=
OPTI_SECRET_TICKETS_SIGNING_KEY=

# 单点登录（S2-D）：配置见 config/oidc.yaml 与 deploy/README-oidc.md
OPTI_OIDC_CONFIG=config/oidc.yaml
OPTI_SECRET_OIDC_CLIENT_SECRET=
# 接入单点登录后，口令登录只给应急账号用；设为 false 完全关闭
OPTI_LOCAL_LOGIN=true

# 员工凭据暴露（S3-A）：见 deploy/README-exposure.md
OPTI_HIBP_NOTIFY_MAILBOX=
OPTI_SECRET_HIBP_API_KEY=
OPTI_SECRET_HIBP_NOTIFY_TENANT_ID=
OPTI_SECRET_HIBP_NOTIFY_CLIENT_ID=
OPTI_SECRET_HIBP_NOTIFY_CLIENT_SECRET=

# 勒索泄露站与供应商风险（S3-B）：见 deploy/README-ransomware.md
OPTI_VENDORS=config/vendors.yaml
OPTI_SECRET_RANSOMWARE_LIVE_API_KEY=

# 文档存储（S4-A）：只保存命中文档的标题、摘要、命中片段与正文指纹
# 告警中的本地按需翻译（Phase 2-U）：仅 API 使用，须同时挂载 socket；见 deploy/README-translation.md
# OPTI_TRANSLATION_SOCKET=/run/opti-translation/translate.sock

# 软件清单（S4-C）：与 CISA KEV 比对，只在平台加载，不下发到采集节点
# OPTI_SOFTWARE=config/software.yaml

# 大模型研判与连接器：Web 保存的密钥使用此主密钥加密（API、worker、scheduler 与 gateway 都需要）
# 首次使用可在「设置 → 凭据加密主密钥」中初始化，持久化在共享平台数据目录，无需填写此项。
# 也支持部署环境设置：uv run opti encryption-key-gen；轮换时把旧值移到 _PREVIOUS 后运行 opti rekey
# OPTI_ENCRYPTION_KEY_PREVIOUS=
OPTI_ENCRYPTION_KEY=

# 数据外送（S5-A）：STIX 导出与 SIEM 推送，见 config/sharing.yaml
# OPTI_SHARING_CONFIG=config/sharing.yaml
OPTI_SECRET_SIEM_SIGNING_KEY=
OPTI_SECRET_SIEM_WEBHOOK_TOKEN=

# 保留期统一在 config/retention.yaml 中设置
# OPTI_RETENTION_CONFIG=config/retention.yaml
# OPTI_CAMPAIGNS_CONFIG=config/campaigns.yaml

# 发现密钥的遮蔽指纹（HMAC-SHA256）密钥：至少 32 个字符（openssl rand -hex 32）。
# 必填：缺失时 api/worker/gateway/采集节点拒绝启动。所有采集节点 .env.collector 必须填相同的值。
OPTI_SECRET_MASK_KEY=
